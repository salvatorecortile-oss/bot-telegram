; FiboRetraceM1 v1 - XAUUSD M1, 0.01 lotti, impostazione di partenza
; Dopo l'ottimizzazione copia qui i valori del passaggio migliore.
; Base
InpLots=0.01
InpMagic=61800
; Ingresso: 0=limit 1=mercato 2=mercato+pin bar 3=mercato+engulfing 4=mercato+pin o engulfing
InpEntryMode=0
InpLvl382=true
InpLvl500=true
InpLvl618=true
InpTouchTol=0.06
InpPinWick=0.6
; SL sul livello 1.1 (oltre lo swing low/high)
InpSLFib=1.1
; TP: 0=RR 1:1 1=RR 1:1.5 2=RR 1:2 3=RR 1:3 4=livello 0 (swing) 5=estensione -0.272 6=estensione -0.618 7=ATR x InpTPATRMult
InpTPMode=2
InpTPATRMult=2.0
; Swing e trend (trend: 0=nessuno 1=EMA 2=struttura massimi/minimi)
InpSwingDepth=5
InpLookback=300
InpMinLegATR=2.0
InpMinLegPts=0
InpMaxLegBars=60
InpTrendFilter=0
InpEMAPeriod=50
; Orari (ora di MT5 = italiana + 1): 0=tutto il giorno 1=10-13 (9-12 ita) 2=15-19 (14-18 ita) 3=entrambe
InpSessMode=0
InpSess1Start=10
InpSess1End=13
InpSess2Start=15
InpSess2End=19
; Ottimizzazione
InpMinTrades=30
