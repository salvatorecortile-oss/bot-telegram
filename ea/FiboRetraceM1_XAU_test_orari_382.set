; FiboRetrace v1.1 - TEST ORARI + LIVELLO 0.382 (M1, set definitivo), XAUUSD, 0.01 lotti, deposito 1000
; Tutto come il set definitivo (pin bar su 0.5/0.618, SL 1.1, TP RR 1:3, swing 3, impulso 4 x ATR, EMA).
; Provati: inizio fascia 8/9/10 MT5 (7/8/9 italiane) x fine 12/13/14/15/16 MT5 (11/12/13/14/15 italiane)
; x livello 0.382 si/no = 3 x 5 x 2 = 30 combinazioni.
; "Algoritmo completo lento", criterio "Custom max", modello "Ogni tick basato su tick reali", forward 1/3.
; Simbolo XAUUSD, grafico M1, dal 2026.01.01 a oggi. Il passaggio 10-13 senza 0.382 e' il set attuale (riferimento).
; Base
InpLots=0.01||0.01||0.1||0.01||N
InpMagic=61800||61800||1||61800||N
; Time frame: 0=M1
InpTF=0||0||1||0||N
; Ingresso: 0=limit 1=mercato 2=mercato+pin bar 3=mercato+engulfing 4=mercato+pin o engulfing
InpEntryMode=2||2||1||2||N
InpLvl382=false||false||0||true||Y
InpLvl500=true||false||0||true||N
InpLvl618=true||false||0||true||N
InpTouchTol=0.06||0.06||0.1||0.06||N
InpPinWick=0.6||0.6||0.1||0.6||N
; SL sul livello 1.1 (oltre lo swing low/high)
InpSLFib=1.1||1.1||0.1||1.1||N
; TP: 0=RR 1:1 1=RR 1:1.5 2=RR 1:2 3=RR 1:3 4=livello 0 (swing) 5=estensione -0.272 6=estensione -0.618 7=ATR x InpTPATRMult
InpTPMode=3||3||1||3||N
InpTPATRMult=2.0||2.0||0.1||2.0||N
; Swing e trend (trend: 0=nessuno 1=EMA 2=struttura massimi/minimi)
InpSwingDepth=3||3||1||3||N
InpLookback=300||300||1||300||N
InpMinLegATR=4.0||4.0||0.1||4.0||N
InpMinLegPts=0||0||1||0||N
InpMaxLegBars=60||60||1||60||N
InpTrendFilter=1||1||1||1||N
InpEMAPeriod=50||50||1||50||N
; Orari (ora di MT5 = italiana + 1): 1 = solo fascia 1
InpSessMode=1||1||1||1||N
InpSess1Start=10||8||1||10||Y
InpSess1End=13||12||1||16||Y
InpSess2Start=15||15||1||15||N
InpSess2End=19||19||1||19||N
; Weekend (spento come nel set definitivo)
InpWeekend=false||false||0||true||N
InpFriNoNew=2100||2100||1||2100||N
InpFriClose=2245||2245||1||2245||N
; Ottimizzazione
InpMinTrades=30||30||1||30||N
