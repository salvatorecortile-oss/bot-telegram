# Copia questo file in .env e cambia solo quello che ti serve.
# Nessuna password qui: Kronos legge le candele dal MetaTrader 5 aperto.

# Percorso di terminal64.exe (vuoto = MT5 gia' aperto)
MT5_PATH=

KRONOS_SYMBOL=XAUUSD
KRONOS_TIMEFRAME=M15
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=12
KRONOS_SAMPLES=20

# Modello: Kronos-small (consigliato) o Kronos-base (piu preciso ma lento).
# Kronos-mini va usato con KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-2k
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=auto

KRONOS_BULLISH_THRESHOLD=0.65
KRONOS_BEARISH_THRESHOLD=0.35

KRONOS_HOST=127.0.0.1
KRONOS_PORT=8765

# Previsioni automatiche a ogni candela chiusa + registro di verifica
# (true = attivo, false = solo su richiesta)
KRONOS_AUTO=true
