# Copia questo file in ".env" (nella stessa cartella news_bot) e compila i valori.

# Credenziali Telegram (le stesse di my.telegram.org usate dal bot MT5).
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=la_tua_api_hash

# Nome della sessione del bot notizie (diversa da quella del bot MT5,
# così i due bot possono girare insieme senza darsi fastidio).
NEWS_SESSION_NAME=news_bot

# ID del canale dove pubblicare (usa trova_canale.py per trovarlo).
# Il tuo account deve essere admin del canale con permesso di pubblicare.
# Per ora: canale di TEST "news". Quando è tutto ok si passa al gruppo Community.
NEWS_CHANNEL=-1004400822982

# Fuso orario e ora del buongiorno + riepilogo.
TIMEZONE=Europe/Rome
MORNING_HOUR=6
MORNING_MINUTE=0

# Ogni quanti secondi controllare le fonti.
POLL_SECONDS=120

# ===== CLAUDE (redattore AI) =====
# Chiave API da https://console.anthropic.com  (Settings -> API Keys).
# Se la lasci vuota il bot usa solo il filtro a parole chiave + Google Translate.
ANTHROPIC_API_KEY=

# Modello: claude-opus-5-5 (il migliore), claude-sonnet-5-5 (metà prezzo),
# claude-haiku-4-5 (il più economico).
AI_MODEL=claude-opus-5-5
# Quanto "ragiona" Claude: low (economico, basta per le notizie), medium, high.
AI_EFFORT=low

# Voto di Claude (da 1 a 10) per pubblicare SUBITO e per il riepilogo delle 6:00.
AI_INSTANT_MIN=9
AI_RECAP_MIN=7

# Prima scrematura gratuita: solo le notizie con punteggio parole chiave >= questo
# valore vengono mandate a Claude (più alto = meno notizie = meno costi).
AI_PREFILTER=50

# Tetto di sicurezza sulle chiamate a Claude al giorno.
MAX_AI_CALLS_PER_DAY=150

# ===== Filtro senza AI (usato solo se ANTHROPIC_API_KEY è vuota) =====
# Soglia di importanza (0-150). Più è alta, meno notizie arrivano.
#  - INSTANT_THRESHOLD: notizia inviata subito nel canale
#  - RECAP_THRESHOLD: notizia inclusa nel riepilogo delle 6:00
INSTANT_THRESHOLD=75
RECAP_THRESHOLD=60

# Massimo di notizie istantanee per ora (anti-spam).
MAX_ALERTS_PER_HOUR=4

# Quante notizie al massimo nel riepilogo mattutino.
RECAP_MAX_ITEMS=10

# Ore di silenzio opzionali per le notizie istantanee, es. "23-6".
# Vuoto = le notizie importanti arrivano a qualsiasi ora.
QUIET_HOURS=

# true = non pubblica nulla su Telegram, scrive solo nel log (per le prove).
DRY_RUN=false
