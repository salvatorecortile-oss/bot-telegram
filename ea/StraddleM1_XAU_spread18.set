; StraddleM1 v9 - conto XAUUSD spread 18 (0.01 lotti, capitale 100)
; Parametri del miglior passaggio 2025-2026 su Demo2: +1730 $, PF 1.52, DD 20%, 14769 trade
; Base
InpLots=0.01
InpAutoStart=true
InpMagic=52001
; Distanze in punti (0 = automatico dall'ATR M1)
InpEntryPts=50
InpSLPts=15
InpBEPts=30
InpBELockPts=5
InpTrailStartPts=35
InpTrailDistPts=25
InpMaxSpreadPts=0
InpScaleRefATR=250
InpMinATRSpr=0
; Filtro laterale (lavora solo sui movimenti veri)
InpBigOnly=true
InpERPeriod=6
InpERMin=0.4
InpBigK=0.6
InpBigSpreadMult=10
InpTrendSide=false
InpActiveSec=20
InpMaxPerDir=2
; Modalita' laterale (limit)
InpRangeMode=true
InpRangeBars=15
InpRangeMaxER=0.25
InpRangeMinSpr=8
InpRangeSLPct=0.3
InpRangeMaxSLPts=40
InpRangeUseTP=false
InpRangeTPPct=0.5
; Uscita breakout fallito
InpFailExit=true
