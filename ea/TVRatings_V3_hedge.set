; TVRatings v3 - VERSIONE 3: Buy e Sell insieme quando ADX < massimo, TP 10 punti, griglia opzionale, M5 (serve conto hedging)
; Valori con ||inizio||passo||fine||Y = ottimizzati. Caricali da Strategy Tester > Parametri > tasto destro > Carica.
; Strategia
InpStrategy=1
InpInvert=false
; Segnale
InpSignalTF=5
InpSignalSrc=0
InpEntryMode=1
InpBuyLevel=0.1||0.1||0.1||0.5||Y
InpSellLevel=-0.1||-0.5||0.1||-0.1||Y
InpDirection=0
InpReenterSameBar=true
InpReopenAfterTP=true
InpReopenDelaySec=0
; Filtro direzione su altri timeframe
InpUseFilter=false
InpFilterTF=16408
InpFilterSrc=0
InpFilterLevel=0.1
InpFilterAllTF=false
; Filtri di mercato
InpADXSrc=0
InpADXFiltLen=14
InpADXMin=0
InpADXMax=20||15||5||35||Y
InpADXCloseOut=false
InpATRMaxPts=0
InpVolBlockGrid=false
InpMaxFlips=0
InpFlipWindowMin=30
InpFlipPauseMin=60
; Notizie
InpNewsFilter=false
InpNewsMinBefore=30
InpNewsMinAfter=30
InpNewsCurrency=USD
InpNewsBlockGrid=true
; Uscita
InpExitMode=3
InpNeutralBand=0.1
; Lotto e stop
InpLotMode=0
InpFixedLots=0.01
InpRiskPercent=1.0
InpBalancePerLot=1000
InpMaxLots=0
InpStopMode=2
InpSLPips=500
InpTPPips=1000
InpATRPeriod=14
InpSLATR=1.5
InpTPATR=3.0
InpSLPoints=0
InpTPPoints=10
InpPipSize=0.01
InpMaxDDPercent=0
; Griglia e paniere
InpGridOn=false||false||0||true||Y
InpGridStepPts=200||100||100||1000||Y
InpGridLotMult=1.0
InpGridMaxLevels=5||2||1||8||Y
InpGridOnlyWithSignal=false
InpBasketExit=0||0||1||1||Y
InpGridTPPts=0
InpBasketProfit=1.0||0.5||0.5||3.0||Y
InpBasketMaxLoss=0||0||100||500||Y
InpBasketMaxHours=0
InpBasketScale=true
InpGridCloseOnFlip=true
; Hedge (versione 3)
InpHedgeNeutralOnly=false||false||0||true||Y
InpHedgeCloseOnTrend=true||false||0||true||Y
; Filtri orario e spread
InpUseHours=false
InpStartHour=8
InpEndHour=20
InpMaxSpread=0
; Ordini
InpMagic=26102801
InpSlippage=30
InpComment=TVRatings
; Tester
InpRebatePerLot=0
InpOptCriterion=1
; Calcolo e grafico
InpHistoryBars=300
InpShowPanel=true
InpPanelAllTF=true
InpLogRatings=false
; Medie mobili (default TradingView)
InpMA1=10
InpMA2=20
InpMA3=30
InpMA4=50
InpMA5=100
InpMA6=200
InpHullLen=9
InpVWMALen=20
InpIchiConv=9
InpIchiBase=26
InpIchiSpanB=52
InpIchiShift=25
; Oscillatori (default TradingView)
InpRSILen=14
InpStochK=14
InpStochSm=3
InpStochD=3
InpCCILen=20
InpCCITypical=false
InpADXLen=14
InpAOFast=5
InpAOSlow=34
InpMomLen=10
InpMACDFast=12
InpMACDSlow=26
InpMACDSig=9
InpSRSIK=3
InpSRSID=3
InpSRSIRsi=14
InpSRSIStoch=14
InpWPRLen=14
InpBBPLen=13
InpUO1=7
