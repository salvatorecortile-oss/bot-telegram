; StraddleM1 v9 - test 0: controllo
; Come il backtest 2 (TrendSide=false, laterale acceso, due fasce) ma con deposito 1000: anno intero senza blocco a gennaio
; Strategy Tester sul server del conto live 48: XAUUSD, M1, 2026.01.01 - 2026.10.19, tick reali, deposito 1000 USD. Lo spread e' gia' nei tick: niente spread simulato
; Base
InpLots=0.01
InpAutoStart=true
InpMagic=52001
; Distanze in punti (0 = automatico dall'ATR M1)
InpEntryPts=50
InpSLPts=15
InpBEPts=30
InpBELockPts=5
InpTrailStartPts=35
InpTrailDistPts=25
InpMaxSpreadPts=0
InpScaleRefATR=250
InpMinATRSpr=0
; Filtro laterale (lavora solo sui movimenti veri)
InpBigOnly=true
InpERPeriod=6
InpERMin=0.4
InpBigK=0.6
InpBigSpreadMult=4
InpTrendSide=false
InpActiveSec=20
InpMaxPerDir=2
; Modalita' laterale (limit)
InpRangeMode=true
InpRangeBars=15
InpRangeMaxER=0.25
InpRangeMinSpr=8
InpRangeSLPct=0.3
InpRangeMaxSLPts=40
InpRangeUseTP=false
InpRangeTPPct=0.5
; Uscita breakout fallito
InpFailExit=true
InpFailSec=10
; Filtro orario (ora di MT5, quella del Market Watch). Inizio = fine -> fascia spenta
InpUseSessions=true
InpSess1Start=10
InpSess1End=13
InpSess2Start=15
InpSess2End=17
; Registro
InpLogCSV=false
; Volume / IB
InpRebatePerLot=10.0
; Limiti giornalieri (valuta conto, 0 = off)
InpMaxDailyLoss=0.0
InpDailyTarget=0.0
InpMaxTradesDay=0
; Protezione capitale
InpEquityFloor=0
; Solo Strategy Tester
InpTestExtraSpread=0
