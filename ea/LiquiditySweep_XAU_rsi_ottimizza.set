; LiquiditySweep v2.00 - OTTIMIZZAZIONE modalita' RSI (Slow complete: 192 combinazioni), forward 1/3, criterio Balance max
; InpEntryMode: 0 = sweep M5, 1 = RSI M1 + sweep, 2 = solo RSI M1
; Modalita' di entrata
InpEntryMode=1||1||1||2||Y
InpRSIPeriod=28
InpRSILow=30.0
InpRSIHigh=70.0
; Base
InpLots=0.01
InpMagic=53001
InpRR=2.0||1.5||0.5||3.0||Y
; Livelli (ora di MT5 = ora italiana + 1: Asia 00-07 italiane = 01-08 MT5)
InpUseD1=true
InpUseAsia=true
InpAsiaStart=100
InpAsiaEnd=800
; Sweep e conferma (candele M5)
InpMaxBarsOut=12
InpMaxDepthATR=2.0||1.0||1.0||3.0||Y
InpMaxDepthPts=0
InpATRPeriod=14
; Stop loss e break-even
InpSLBufferPts=20
InpSLBufferATR=0.3||0||0.2||0.6||Y
InpMaxSLATR=4.0
InpMaxSLPts=0
InpMinSLPts=50
InpBreakEvenR=0
InpBELockPts=10
; Limiti
InpMaxTradesLevel=3
InpOnePerLevel=true
InpOnePerBar=true
InpMaxSpreadPts=60
InpTrendEMA=0||0||20||20||Y
; Sessioni di entrata (ora di MT5)
InpUseLondon=true
InpLonStart=1000
InpLonEnd=1400
InpUseNY=true
InpNYStart=1530
InpNYEnd=1900
; Grafico
InpDrawLevels=false
