; RSI_M1_XAU v3.20 - TEST TP BUY e SELL separati, sul set definitivo
; TP BUY a RSI 50-55-60-65-70  x  TP SELL a RSI 50-45-40-35-30
; Ottimizzazione "Slow complete algorithm": 25 test, senza forward. Periodo 2026, tick reali
; Base
InpLots=0.01||0.01||0||0.01||N
InpMagic=54001||54001||0||54001||N
; RSI (M1)
InpRSIPeriod=28||28||0||28||N
InpRSILow=30.0||30.0||0||30.0||N
InpRSIHigh=70.0||70.0||0||70.0||N
InpRSIExit=50.0||50.0||5.0||70.0||Y
InpRSIExitSell=50.0||30.0||5.0||50.0||Y
; Stop loss (ATR)
InpATRTF=1||1||0||1||N
InpATRPeriod=14||14||0||14||N
InpSLATR=2.5||2.5||0||2.5||N
; Operazioni
InpOneAtTime=true||false||0||true||N
; Weekend (ora di MT5)
InpWeekend=true||false||0||true||N
InpFriNoNew=2100||2100||0||2100||N
InpFriClose=2245||2245||0||2245||N
; Fascia oraria di entrata (ora di MT5)
InpUseHours=true||false||0||true||N
InpHourStart=1300||1300||0||1300||N
InpHourEnd=2000||2000||0||2000||N
; Volatilita' (ATR in % del prezzo)
InpUseATRFilter=true||false||0||true||N
InpMinATRPct=0.05||0.05||0||0.05||N
InpMaxATRPct=0.13||0.13||0||0.13||N
