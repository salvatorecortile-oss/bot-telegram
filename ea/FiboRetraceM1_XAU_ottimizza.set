; FiboRetraceM1 v1 - OTTIMIZZAZIONE XAUUSD M1, 0.01 lotti
; Prova in un solo file tutte le combinazioni:
;   ingresso (limit / mercato / mercato+pin bar / mercato+engulfing / mercato+pin o engulfing)
;   x livelli 0.382 / 0.5 / 0.618 (singoli e scalati) x 8 tipi di TP x 4 fasce orarie
;   x filtro trend x profondita' swing x impulso minimo
; Ogni riga ha ||N (non ottimizzare) o ||Y: le spunte vecchie non restano attive.
; Circa 34.000 combinazioni: usa "Algoritmo genetico veloce", criterio "Custom max"
; (= profitto / drawdown, scarta i passaggi con meno di InpMinTrades trade).
; Modello: "Ogni tick basato su tick reali". Forward 1/3 per controllare che regga.
; Base
InpLots=0.01||0.01||0.1||0.01||N
InpMagic=61800||61800||1||61800||N
; Ingresso: 0=limit 1=mercato 2=mercato+pin bar 3=mercato+engulfing 4=mercato+pin o engulfing
InpEntryMode=0||0||1||4||Y
InpLvl382=true||false||0||true||Y
InpLvl500=true||false||0||true||Y
InpLvl618=true||false||0||true||Y
InpTouchTol=0.06||0.06||0.1||0.06||N
InpPinWick=0.6||0.6||0.1||0.6||N
; SL sul livello 1.1 (oltre lo swing low/high)
InpSLFib=1.1||1.1||0.1||1.1||N
; TP: 0=RR 1:1 1=RR 1:1.5 2=RR 1:2 3=RR 1:3 4=livello 0 (swing) 5=estensione -0.272 6=estensione -0.618 7=ATR x InpTPATRMult
InpTPMode=2||0||1||7||Y
InpTPATRMult=2.0||2.0||0.1||2.0||N
; Swing e trend (trend: 0=nessuno 1=EMA 2=struttura massimi/minimi)
InpSwingDepth=5||3||2||7||Y
InpLookback=300||300||1||300||N
InpMinLegATR=2.0||1.0||1.0||3.0||Y
InpMinLegPts=0||0||1||0||N
InpMaxLegBars=60||60||1||60||N
InpTrendFilter=0||0||1||2||Y
InpEMAPeriod=50||50||1||50||N
; Orari (ora di MT5 = italiana + 1): 0=tutto il giorno 1=10-13 (9-12 ita) 2=15-19 (14-18 ita) 3=entrambe
InpSessMode=0||0||1||3||Y
InpSess1Start=10||10||1||10||N
InpSess1End=13||13||1||13||N
InpSess2Start=15||15||1||15||N
InpSess2End=19||19||1||19||N
; Ottimizzazione
InpMinTrades=30||30||1||30||N
