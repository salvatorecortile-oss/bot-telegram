# ==========================================================
# BOT SICUREZZA - copia questo file in ".env" e compilalo
# ==========================================================

# --- TELEGRAM (da https://my.telegram.org -> API development tools) ---
# Puoi usare gli stessi API ID / HASH degli altri bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=sicurezza_session

# ID della sala elite e del canale, separati da virgola
# (li trovi con: python get_chats.py ; di solito iniziano con -100...)
TELEGRAM_CHATS=-1001111111111,-1002222222222

# --- REPORT ---
# Nomi da proteggere dalle imitazioni (il tuo nome e' gia' incluso in automatico)
NOMI_PROTETTI=Sala Elite
# ID da cui un account si considera "creato di recente" (stima)
ID_ACCOUNT_RECENTE=7000000000

# --- GUARDIANO (facoltativo: captcha per chi chiede di entrare) ---
# Token del bot creato con @BotFather
BOT_TOKEN=
BOT_SESSION_NAME=sicurezza_bot
# Il tuo ID Telegram (lo stampa get_chats.py). Il bot ti avvisa qui. Scrivi prima /start al bot.
ADMIN_USER_ID=
# Secondi per rispondere al captcha e tentativi a disposizione
CAPTCHA_TIMEOUT_SECONDS=180
CAPTCHA_TENTATIVI=2
