; LiquiditySweep - XAUUSD, conferma M5, RR 1:2, lotto fisso
; Base
InpLots=0.01
InpMagic=53001
InpRR=2.0
; Livelli (ora di MT5 = ora italiana + 1: Asia 00-07 italiane = 01-08 MT5)
InpUseD1=true
InpUseAsia=true
InpAsiaStart=100
InpAsiaEnd=800
; Sweep e conferma (candele M5)
InpMaxBarsOut=12
InpMaxDepthATR=2.0
InpMaxDepthPts=0
InpATRPeriod=14
; Stop loss e break-even
InpSLBufferPts=20
InpMaxSLATR=4.0
InpMaxSLPts=0
InpMinSLPts=50
InpBreakEvenR=0
InpBELockPts=10
; Limiti
InpMaxTradesLevel=3
InpOnePerLevel=true
InpOnePerBar=true
InpMaxSpreadPts=60
; Sessioni di entrata (ora di MT5)
InpUseLondon=true
InpLonStart=900
InpLonEnd=1400
InpUseNY=true
InpNYStart=1530
InpNYEnd=1900
; Grafico
InpDrawLevels=true
