# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env.

# =========================
# TELEGRAM
# =========================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=gold_mo_copier

TELEGRAM_SOURCE_CHAT=-1002495224665
TELEGRAM_DESTINATION_CHAT=-1004456671842

# =========================
# MT5
# =========================
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# =========================
# TRADING
# =========================
MT5_SYMBOL=XAUUSD
LOT_SIZE=0.01
MAX_SIGNAL_AGE_SECONDS=60
DEVIATION=50
MAGIC_NUMBER=26090201
ORDER_COMMENT=Gold MO Copier
MONITOR_INTERVAL_SECONDS=0.5

# Profitto (in PIPS, dal pip_size reale letto da MT5) al quale lo SL
# viene spostato a Break Even.
BE_TRIGGER_PIPS=50

TRADING_ENABLED=true
DEBUG=true

# =========================
# COMANDI REMOTI (da "Messaggi Salvati")
# =========================
COMMAND_PREFIX=bot5_

# =========================
# AUTOMATISMI (orario Europe/Rome, lun-ven salvo dove indicato)
# =========================
GOOD_MORNING_HOUR=6
GOOD_MORNING_MINUTE=0
DAILY_CLOSE_HOUR=22
DAILY_CLOSE_MINUTE=45
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=0
WEEKLY_REPORT_HOUR=10
WEEKLY_REPORT_MINUTE=0

BRAND_NAME=GOLD MO
