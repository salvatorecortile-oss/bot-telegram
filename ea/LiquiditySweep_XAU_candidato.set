; LiquiditySweep v1.10 - CANDIDATO dall'ottimizzazione 2026 (gruppo positivo sia back che forward)
; Da verificare su un periodo MAI usato: 2024.01.01 - 2025.12.31
; Modalita' di entrata
InpEntryMode=0
InpRSIPeriod=28
InpRSILow=30.0
InpRSIHigh=70.0
; Base
InpLots=0.01
InpMagic=53001
InpRR=1.5
; Livelli (ora di MT5 = ora italiana + 1: Asia 00-07 italiane = 01-08 MT5)
InpUseD1=true
InpUseAsia=true
InpAsiaStart=100
InpAsiaEnd=800
; Sweep e conferma (candele M5)
InpMaxBarsOut=3
InpMaxDepthATR=2.0
InpMaxDepthPts=0
InpATRPeriod=14
; Stop loss e break-even
InpSLBufferPts=20
InpSLBufferATR=0.7
InpMaxSLATR=4.0
InpMaxSLPts=0
InpMinSLPts=50
InpBreakEvenR=0
InpBELockPts=10
; Limiti
InpMaxTradesLevel=3
InpOnePerLevel=true
InpOnePerBar=true
InpMaxSpreadPts=60
InpTrendEMA=0
; Sessioni di entrata (ora di MT5)
InpUseLondon=true
InpLonStart=1000
InpLonEnd=1400
InpUseNY=true
InpNYStart=1530
InpNYEnd=1900
; Grafico
InpDrawLevels=true
