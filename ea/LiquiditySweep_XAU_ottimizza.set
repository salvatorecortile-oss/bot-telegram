; LiquiditySweep v1.10 - OTTIMIZZAZIONE (Slow complete o Genetic), forward 1/3, criterio Profit Factor o Balance max
; Base
InpLots=0.01
InpMagic=53001
InpRR=2.0||1.5||0.5||3.0||Y
; Livelli (ora di MT5 = ora italiana + 1: Asia 00-07 italiane = 01-08 MT5)
InpUseD1=true
InpUseAsia=true
InpAsiaStart=100
InpAsiaEnd=800
; Sweep e conferma (candele M5)
InpMaxBarsOut=12||3||3||12||Y
InpMaxDepthATR=2.0||1.0||0.5||3.0||Y
InpMaxDepthPts=0
InpATRPeriod=14
; Stop loss e break-even
InpSLBufferPts=20
InpSLBufferATR=0.3||0||0.1||0.8||Y
InpMaxSLATR=4.0
InpMaxSLPts=0
InpMinSLPts=50
InpBreakEvenR=0
InpBELockPts=10
; Limiti
InpMaxTradesLevel=3
InpOnePerLevel=true
InpOnePerBar=true
InpMaxSpreadPts=60
InpTrendEMA=0||0||20||50||Y
; Sessioni di entrata (ora di MT5)
InpUseLondon=true
InpLonStart=1000||900||100||1000||Y
InpLonEnd=1400
InpUseNY=true
InpNYStart=1530
InpNYEnd=1900
; Grafico
InpDrawLevels=false
