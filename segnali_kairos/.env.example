# ==========================================================
# SALA SEGNALI KAIROS - copia questo file in ".env" e compilalo
# ==========================================================

# --- TELEGRAM (da https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=segnali_kairos_session

# ID del canale (sala segnali) dove pubblicare: lo trovi con  python get_chats.py
# (di solito inizia con -100...). Il tuo account deve essere amministratore del canale.
TELEGRAM_DESTINATION_CHAT=

# --- MT5 (solo lettura) ---
# Se MT5 e' gia' aperto e loggato sul conto del bot puoi lasciare vuoti login/password/server.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Magic number delle operazioni da pubblicare (Fibonacci 61800, Kairos RSI 54001).
# Lascia vuoto (MAGIC_NUMBERS=) per pubblicare TUTTE le operazioni del conto, anche quelle manuali.
MAGIC_NUMBERS=61800,54001
# Solo questo simbolo (vuoto = tutti)
MT5_SYMBOL=
# Nome del simbolo nei messaggi (vuoto = quello di MT5 senza suffisso: XAUUSD-P -> XAUUSD)
DISPLAY_SYMBOL=
# 1 pip = 0,10 $ sull'oro
PIP_SIZE=0.1
# Ogni quanti secondi legge le posizioni
POLL_INTERVAL_SECONDS=2
# All'avvio pubblica solo le posizioni aperte da meno di questi secondi
MAX_OPEN_AGE_SECONDS=300

# Prefisso comandi in "Messaggi salvati" (segnali_status, segnali_pausa, ...)
COMMAND_PREFIX=segnali_
