# ==========================================================
# BOT GOLD EMPIRE - copia questo file in ".env" e compilalo
# ==========================================================

# --- TELEGRAM (da https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=goldempire_session

# ID canale "Gold empire signals room" e del TUO canale di destinazione
# (li trovi con: python get_chats.py ; di solito iniziano con -100...)
TELEGRAM_SOURCE_CHAT=
TELEGRAM_DESTINATION_CHAT=

# --- MT5 ---
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- TRADING ---
# false = modalita' TEST: copia nel canale ma NON apre ordini su MT5
TRADING_ENABLED=false
MT5_SYMBOL=XAUUSD
LOT_SIZE=0.01
DEVIATION=50
MAGIC_NUMBER=26090110
ORDER_COMMENT=GoldEmpire

# Segnali di apertura piu' vecchi di questi secondi vengono ignorati
MAX_SIGNAL_AGE_SECONDS=120
# Distanza massima in $ tra prezzo di mercato e "Ingresso" (0 = nessun limite)
MAX_ENTRY_DISTANCE=2

# Ordini LIMIT/STOP non eseguiti entro questi minuti vengono annullati (0 = mai)
PENDING_EXPIRY_MINUTES=1440

# Segnali "stop and reverse": un SIGNAL N opposto chiude le operazioni dello stesso SIGNAL N
REVERSAL_SIGNALS=5,6

# Dopo una chiusura scritta a parole (senza reply), altri messaggi simili entro questi minuti vengono ignorati
FREE_CLOSE_COOLDOWN_MINUTES=10

# false = legge il canale e opera su MT5 ma NON scrive niente nel canale di destinazione
# (per una seconda copia del bot su un altro conto)
PUBLISH_TO_CHANNEL=true

# Allineamento tra due conti sulla stessa VPS (stesso file nei due .env):
# conto principale -> SYNC_ROLE=master, copia -> SYNC_ROLE=follower. Vuoto = disattivato.
SYNC_FILE=
SYNC_ROLE=

# Regole di apertura (sul conto principale; le copie aprono solo cio' che apre il principale)
MAX_PER_DIRECTION=2          # max operazioni BUY e max operazioni SELL insieme (0 = nessun limite)
ONE_PER_FAMILY=true          # una sola operazione per famiglia e direzione (tutti i 5.x = famiglia 5)
LOW_PRIORITY_SIGNALS=4       # si aprono solo se nella loro direzione non c'e' nulla di aperto
EXCLUDED_SIGNALS=            # segnali da non aprire mai, es. 4

# Protezione del conto: pausa delle nuove aperture (0 = disattivata)
RISK_DAILY_LOSS_PCT=6
RISK_MONTHLY_LOSS_PCT=20

# Prefisso comandi in "Messaggi salvati" (bot3_status, bot3_pausa, ...).
# NON usare bot2_: e' gia' del tuo altro bot e i comandi agirebbero su entrambi.
COMMAND_PREFIX=bot3_
